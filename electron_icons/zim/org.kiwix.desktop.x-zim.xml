<?xml version="1.0" encoding="UTF-8"?>
<!--
  The shared-mime-info definition for ZIM archives, installed by the deb and rpm packages.

  This is shipped rather than left to the one electron-builder generates from
  build.linux.fileAssociations, which cannot express:

  * both globs under a single type: it writes "*.${ext}" per association, which would emit the
    type twice and list it twice on the desktop entry's MimeType line;
  * weight, which is what lets this claim on *.zim outrank the weight-50 glob that an installed
    Kiwix JS PWA writes into the user's own MIME database, mapping *.zim to
    application/octet-stream (see kiwix-js-pwa #964);
  * <magic>, so that a ZIM is recognized by content even when it has been renamed;
  * the absence of an <icon>, which it hardcodes to "x-office-document".

  There is deliberately no <icon> element here. kiwix-desktop, which defines this same type,
  declares <icon name="org.kiwix.desktop.x-zim"/> and ships that icon, and a MIME type can only
  have one icon however many packages define it. Leaving ours out means the lookup falls through
  to the name derived from the type itself, "application-org.kiwix.desktop.x-zim", which is what
  our packages install: our icon is used when this app is the only one installed, and
  kiwix-desktop's declaration wins outright wherever both are, rather than by order of
  installation. See build.linux.fpm in package.json for where the icons are installed.

  The type and the magic number match kiwix-desktop's own definition, so that both apps are
  offered for the same type rather than competing over two names for one format.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/org.kiwix.desktop.x-zim">
    <comment>ZIM archive</comment>
    <magic priority="50">
      <match type="little32" value="72173914" offset="0"/>
    </magic>
    <glob pattern="*.zim" weight="60"/>
    <glob pattern="*.zimaa" weight="60"/>
  </mime-type>
</mime-info>
